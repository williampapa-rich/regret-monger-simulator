# 이 파일을 .env로 복사한 뒤 값을 채워 넣으세요.
#   cp .env.example .env

# ===== KRX (한국 주식 종목 디렉터리) =====
# 한국거래소(KRX) 정보데이터시스템에 회원가입 후 ID/비밀번호를 적습니다.
# pykrx가 종목명을 가져올 때 이 계정으로 로그인합니다.
# 가입: https://data.krx.co.kr/
KRX_ID=
KRX_PW=

# ===== Binance / Upbit (선택) =====
# 공개 캔들·종목 리스트는 무인증으로 충분하므로 비워두어도 됩니다.
# 향후 주문 기능 등을 쓸 때만 채우세요.
BINANCE_API_KEY=
BINANCE_API_SECRET=
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
